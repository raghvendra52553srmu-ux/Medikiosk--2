# ─────────────────────────────────────────────────────────────
# Frontend environment (Vite). Copy to .env.local and adjust.
# Only VITE_* variables are exposed to the browser — never put a
# secret here; anything in this file ships inside the bundle.
# ─────────────────────────────────────────────────────────────

# Where the browser sends API calls.
# Leave as /api to use the dev-server proxy (recommended: same-origin,
# so the httpOnly auth cookie works without CORS gymnastics).
VITE_API_URL=/api

# Where the Vite dev server forwards /api and /socket.io.
VITE_API_PROXY=http://localhost:4000

# Only needed if the realtime server lives on a different origin
# from the API (uncommon).
# VITE_SOCKET_URL=http://localhost:4000
