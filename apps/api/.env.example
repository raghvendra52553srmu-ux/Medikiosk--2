# ── Database ───────────────────────────────────────────────
# Local MySQL, or a hosted URL (PlanetScale / Railway / your own server).
DATABASE_URL="mysql://USER:1234@HOST:3306/medikiosk"

# ── Auth ───────────────────────────────────────────────────
# Generate a strong value:  openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="8h"

# ── Server ─────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed browser origins.
CORS_ORIGIN="http://localhost:5173,https://medikiosk-2.vercel.app"
# Or single frontend production URL on Render / Vercel:
FRONTEND_URL="https://medikiosk-frontend.onrender.com"

# Hours a kiosk patient session stays valid before it expires.
SESSION_TTL_HOURS=12

# Send cookies only over HTTPS. MUST be true in production.
COOKIE_SECURE=false

# ── Seed (optional) ────────────────────────────────────────
# Passwords for the seeded demo staff accounts. If unset, the seed
# script generates random ones and prints them once.
SEED_DOCTOR_PASSWORD=Doctor@123
SEED_ADMIN_PASSWORD=Admin@123

# ── Payment Gateway (Razorpay for Card Payments) ───────────
# Add your live or test API keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID="rzp_test_YourKeyIdHere"
RAZORPAY_KEY_SECRET="YourRazorpaySecretKeyHere"

# ── Speech-to-Text (AssemblyAI) ────────────────────────────
# API key for multilingual voice input transcription
ASSEMBLYAI_API_KEY="725148352e8d4e57acc655f894894636"
