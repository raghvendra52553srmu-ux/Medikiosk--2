# ── Database ───────────────────────────────────────────────
# Local MySQL, or a hosted URL (PlanetScale / Railway / your own server).
DATABASE_URL="mysql://USER:1234@HOST:3306/medikiosk"

# ── Auth ───────────────────────────────────────────────────
# Generate a strong value:  openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="8h"

# ── Server ─────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed browser origins.
CORS_ORIGIN="http://localhost:5173,https://medikiosk-2.vercel.app"

# Hours a kiosk patient session stays valid before it expires.
SESSION_TTL_HOURS=12

# Send cookies only over HTTPS. MUST be true in production.
COOKIE_SECURE=false

# ── Seed (optional) ────────────────────────────────────────
# Passwords for the seeded demo staff accounts. If unset, the seed
# script generates random ones and prints them once.
SEED_DOCTOR_PASSWORD=Doctor@123
SEED_ADMIN_PASSWORD=Admin@123
